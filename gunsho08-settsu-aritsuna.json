 "blocks": [
  {
   "id": "gunsho08-settsu-aritsuna-0001",
   "pid": "1879502",
   "pages": [
    33
   ],
   "text": "攝津守有綱家歌合一番[舊本行書躰]承保二年八月廿日拾國合之題風霧野花蘆雁鹿戀松榊鶯鹿櫻紅葉卯花雪郭公千島歌人松通宗よろつよの子日とそ見る春かすみ棚引山の峯のまつはら榊橘成元かけまくもかしこき神の榊はを手にとる君は萬よやへむ鶯勝國元梅か香をとめつゝ鳴か山里の垣ねをつとふ鶯のこゑ鹿吹かへす葛のうら風さひしきに鹿も鳴也秋の夕暮櫻持源緣山さくら白雲にのみまかへはや春のこゝろのそらになるらん紅葉行宗秋ふかみあさ夕霧のたつ田山紅葉のにしきゝてのみそみる卯花歌人左帶刀兼定史大夫成時帶刀教定右越後四郞馬大夫賴〓攝津守有綱家歌合兵衞大夫縫殿助上總大夫惟〓遠江前司",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
   ],
   "lb": []
  },
  {
   "id": "gunsho08-settsu-aritsuna-0002",
   "pid": "1879502",
   "pages": [
    34
   ],
   "text": "承曆二年内裏歌合兵部大輔かりそめの宿としらる〓はつ雁の雲ゐ遙かに鳴わたるかな六番鹿左縫殿助まつ人もなき山里も秋は猶ねられさりけり鳴鹿のこゑ右馬允宗忠いつとても忘やはするいかなれは秋しも鹿の妻をしるらむ七番戀左帶刀教定こひすれは旅れの床の草枕露置增るものにそ有ける右兵部太輔戀しさに命たえなはつの國のいく田のもりの名にやたかはん右攝津守有綱家歌合以猪苗代謙庭本書寫一按了",
   "poems": [
    "7",
    "8",
    "9",
    "10",
    "11"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "よろつよの子日とそ見る春かすみ棚引山の峯のまつはら",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "かけまくもかしこき神の榊はを手にとる君は萬よやへむ",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "梅か香をとめつゝ鳴か山里の垣ねをつとふ鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "吹かへす葛のうら風さひしきに鹿も鳴也秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山さくら白雲にのみまかへはや春のこゝろのそらになるらん",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "秋ふかみあさ夕霧のたつ田山紅葉のにしきゝてのみそみる",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "かりそめの宿としらる〓はつ雁の雲ゐ遙かに鳴わたるかな",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "まつ人もなき山里も秋は猶ねられさりけり鳴鹿のこゑ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いつとても忘やはするいかなれは秋しも鹿の妻をしるらむ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "こひすれは旅れの床の草枕露置增るものにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "戀しさに命たえなはつの國のいく田のもりの名にやたかはん",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
